# TeslaMate stack secrets — TEMPLATE (committed, no real values).
#
# Copy this to the Pi as ~/.env (NOT committed — .env is git-ignored) and fill in
# strong values. docker compose auto-loads ~/.env when starting ~/docker-compose.yml.
#
# Generate strong values on the Pi, e.g.:
#   TM_ENCRYPTION_KEY:  openssl rand -base64 32
#   TM_DB_PASS:         openssl rand -base64 24 | tr -d '/+='
#   TM_GRAFANA_PW:      openssl rand -base64 18 | tr -d '/+='
#
# ENCRYPTION_KEY encrypts your Tesla API tokens at rest. If you ever change it,
# TeslaMate can no longer decrypt existing tokens and you must sign in again.

# Encrypts the stored Tesla API tokens (TeslaMate ENCRYPTION_KEY)
TM_ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# Postgres password — must match in teslamate, teslamate-db and teslamate-grafana
TM_DB_PASS=change-me-strong-db-password

# Grafana admin password (user: admin). Anonymous viewers don't need this; it's
# only for editing dashboards / admin login at http://192.168.0.111:3000
TM_GRAFANA_PW=change-me-strong-grafana-password
