# Raspberry Pi 5 SSH Configuration
PI_HOST=192.168.0.111
PI_PORT=22
PI_USER=admin
PI_PASSWORD=your-password-here

# UniFi Network — local read-only (View Only) admin on UCK G2 Plus
UNIFI_HOST=192.168.0.180
UNIFI_PORT=443
UNIFI_USERNAME=your-local-unifi-user
UNIFI_PASSWORD=your-password-here
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false
