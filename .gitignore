# Azure Logic Apps Development - .gitignore

# Azure Functions artifacts
bin/
obj/

# VS Code
.vscode/settings.json
.vscode/launch.json

# Azure credentials and local settings
local.settings.json
*.user
*.suo

# Environment variables
.env
.env.local

# Local ARM/Logic App secret parameters (do not commit)
parameters/*.secrets.parameters.json

# Local notes may contain sensitive values
parameters/Notes.txt

# Node modules (if using custom connectors)
node_modules/

# Python virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Logs
*.log
logs/

# OS specific
.DS_Store
Thumbs.db

# IDE
*.swp
*.swo
*~
.idea/

# Temporary files
tmp/
temp/
*.tmp
temp_*.json
create_dashboard.py

# Azurite local storage emulator
__azurite_db_*
__blobstorage__/

# Sensitive output / tokens
scripts/pp_token.txt
scripts/csp_output.txt
