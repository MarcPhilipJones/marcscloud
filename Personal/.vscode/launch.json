{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GPIO Example",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/raspberry_pi/gpio_example.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "HA Client",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/home_assistant/ha_client.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
